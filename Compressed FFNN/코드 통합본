    //
    parameter   COMP_RANK                   = 2
)
(
    clk, reset_n, i_run,
    // For core_control_u block
    i_node_vec_u, i_wegt_vec_u,
    o_u_ce, o_u_we, o_addr_f, o_addr_u,
    // For core_acc_v block
    i_wegt_vec_v,
    o_v_ce, o_v_we, o_addr_v, o_wait_v,
    o_feat, o_feat_valid,
    //
    o_idle_uv, o_run_uv, o_done_uv,
